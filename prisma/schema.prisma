generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model conductores {
  id_usuario String  @id @default(uuid()) @db.Uuid
  licencia   String? @unique
  id_bus     String?
  apellido   String
  email      String  @unique(map: "Pasajero_email_key")
  id_rol     Int
  nombre     String
  tarjeta    String?
  telefono   String
}
